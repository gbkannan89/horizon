# ── Secrets (NEVER commit these) ─────────────────────────────────────────────
.env
*.pem
*.key

# ── Python ────────────────────────────────────────────────────────────────────
api/.venv/
api/__pycache__/
api/**/__pycache__/
api/**/*.pyc
api/**/*.pyo
api/*.egg-info/
api/dist/
api/build/

# ── Flutter / Dart ────────────────────────────────────────────────────────────
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.packages
mobile/pubspec.lock

# ── Android ───────────────────────────────────────────────────────────────────
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
mobile/android/app/debug/
mobile/android/app/release/
*.jks
*.keystore

# ── Node / JS ─────────────────────────────────────────────────────────────────
node_modules/
.next/
dist/
.nuxt/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*.swo

# ── Docker ────────────────────────────────────────────────────────────────────
