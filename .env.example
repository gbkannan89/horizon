# Horizon Environment Configuration
# Copy to .env and adjust for your environment

# Environment
HORIZON_ENV=development

# Database
DATABASE_URL=postgres://horizon:horizon@localhost:5432/horizon?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379

# Event Bus (NATS)
NATS_URL=nats://localhost:4222

# Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=horizon
STORAGE_SECRET_KEY=horizon-secret
STORAGE_BUCKET=horizon-dev

# Auth
JWT_SECRET=dev-secret-key-do-not-use-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=horizon

# Logging
LOG_LEVEL=debug
LOG_FORMAT=console

# Feature Flags
FEATURE_NEW_DASHBOARD=true
