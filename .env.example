# Horizon — Production Environment Variables
# Copy this file to .env on your server and fill in real values
# NEVER commit .env to git!

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password_here
POSTGRES_DB=horizon

# ── JWT Secrets (generate with: openssl rand -hex 32) ────────────────────────
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32_output
JWT_REFRESH_SECRET_KEY=replace_with_another_openssl_rand_hex_32_output

# ── App ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
